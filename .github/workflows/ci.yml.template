# QUIC Test Suite CI/CD Workflow Template
#
# This is a template for integrating the QUIC test suite with GitHub Actions.
# Copy this file to `.github/workflows/ci.yml` and customize as needed.
#
# Features:
# - Automated test execution on push/PR
# - Code coverage reporting
# - Performance regression detection
# - Test result aggregation
# - Failure categorization

name: QUIC Test Suite

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]
  schedule:
    # Run nightly at 2 AM UTC
    - cron: '0 2 * * *'

env:
  # Zig version to use
  ZIG_VERSION: '0.15.1'
  # Coverage threshold (fail if below this percentage)
  COVERAGE_THRESHOLD: 80
  # Performance regression threshold (fail if slower by this percentage)
  PERF_THRESHOLD: 10

jobs:
  # =============================================================================
  # Build and Unit Tests
  # =============================================================================
  build-and-test:
    name: Build and Test (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest, macos-latest]
        # Add windows-latest when Windows support is ready
      fail-fast: false

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Needed for coverage

      - name: Setup Zig
        uses: goto-bus-stop/setup-zig@v2
        with:
          version: ${{ env.ZIG_VERSION }}

      - name: Cache Zig dependencies
        uses: actions/cache@v3
        with:
          path: |
            ~/.cache/zig
            .zig-cache
          key: ${{ runner.os }}-zig-${{ hashFiles('build.zig') }}
          restore-keys: |
            ${{ runner.os }}-zig-

      - name: Build QUIC library
        run: zig build

      - name: Run unit tests
        run: zig build test --summary all | tee test-output.txt

      - name: Parse test results
        if: always()
        run: |
          # TODO: Use ci_helpers.zig to parse and aggregate results
          echo "Test results parsing not yet implemented"

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v3
        with:
          name: test-results-${{ matrix.os }}
          path: test-output.txt

  # =============================================================================
  # Integration Tests
  # =============================================================================
  integration-tests:
    name: Integration Tests
    runs-on: ubuntu-latest
    needs: build-and-test

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Zig
        uses: goto-bus-stop/setup-zig@v2
        with:
          version: ${{ env.ZIG_VERSION }}

      - name: Run integration tests
        run: zig build test --summary all
        env:
          TEST_INTEGRATION: 1

      - name: Aggregate integration results
        if: always()
        run: |
          # TODO: Use ci_helpers.zig to aggregate integration test results
          echo "Integration test aggregation not yet implemented"

