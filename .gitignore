# Private keys and certificates - NEVER commit (blocked by server policy)
# Generate locally with: openssl ecparam -genkey -name prime256v1 -out key.pem
# See tests/certs/README.md for generation instructions
*.key
*.pem
*.crt
*.der

# But preserve README files that explain certificate generation
!tests/certs/README.md
!examples/interop/certs/README.md

# Symlinks to test certificates (generated locally, not committed)
server.crt
server.key

