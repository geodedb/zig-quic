.{
    .name = .quic,
    .version = "0.1.21",
    .fingerprint = 0xc0795252512a1280,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "lib.zig",
        "cmd",
        "tools",
        "tests",
    },
    .dependencies = .{
        // TLS 1.3 implementation (used for QUIC-TLS integration)
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#v0.1.7",
            .hash = "tls-0.1.7-mtEaLNRoEwAm6kC9N1iQRAHBDXuOmxKVvMf--UM6ZgX9",
        },
        // Thread pool for parallel operations
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#v0.2.4",
            .hash = "thread_pool-0.2.4-11B1BsqSdgD2ZmPGiEwbjSR30K8xwBlWsiLt2NKWqpUl",
        },
        // OpenTelemetry instrumentation (gated behind -Dwith_otel; lazy = true
        // so the dependency is never fetched when the flag is off).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#v0.1.5",
            .hash = "otel-0.1.5-B0v3lrgLNACao6o8I6edI_sVKYHDsS69B6e9WJailgkS",
            .lazy = true,
        },
    },
}
