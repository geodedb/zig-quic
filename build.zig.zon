    .fingerprint = 0xc0795252512a1280,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "lib.zig",
        "cmd",
        "tools",
        "tests",
    },
    .dependencies = .{
        // TLS 1.3 implementation (used for QUIC-TLS integration)
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git?ref=v0.1.15#8eda112f3edc47c09cfdb060fca9ee505e6469a8",
            .hash = "tls-0.1.10-mtEaLAq9FADX71B063Zz_xsX_FQoPP8zlqmcu-LrC5Fu",
        },
        // Thread pool for parallel operations
        .thread_pool = .{
