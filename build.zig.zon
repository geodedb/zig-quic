.{
    .name = .quic,
    .version = "0.1.22",
    .fingerprint = 0xc0795252512a1280,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "lib.zig",
        "cmd",
        "tools",
        "tests",
    },
    .dependencies = .{
        // TLS 1.3 implementation (used for QUIC-TLS integration)
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git?ref=v0.1.8#35d21c9462b1575413963f41843efad5d2bdc535",
            .hash = "tls-0.1.8-mtEaLISNEwAdIavJIHw-N-jby1Z-8V_NfD9uOpWxlstS",
        },
        // Thread pool for parallel operations
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#39528a3e92212efab8ed5840bc20e619a419c0f5",
            .hash = "thread_pool-0.2.4-11B1BnyUdgCUNlqgBwHNvE4plLwP1s1MAyCjODPafrpo",
        },
        // OpenTelemetry instrumentation (gated behind -Dwith_otel; lazy = true
        // so the dependency is never fetched when the flag is off).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.7#479c6c5a552e432ff3908b2167b4eab3057e56dc",
            .hash = "otel-0.1.7-B0v3lvwMNABbcgWlpbEityFzWmMeqp2H-G5PKV4YonCx",
            .lazy = true,
        },
    },
}
