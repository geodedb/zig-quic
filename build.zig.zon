.{
    .name = .quic,
    .version = "0.1.40",
    .fingerprint = 0xc0795252512a1280,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "lib.zig",
        "cmd",
        "tools",
        "tests",
    },
    .dependencies = .{
        // TLS 1.3 crypto seam; flags are propagated by build.zig.
        // Keep its FIPS and thread-pool pins identical to the direct pins below.
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#b74424e2a66fa8ce5a5825a6dc9e41e2d1270c8d",
            .hash = "tls-0.1.21-mtEaLKd2FgB2Es85SvqqtmphvfCGUlgR1V21VaLVcnfd",
        },
        // Thread pool for parallel operations
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.8#2161d8e77beb6f9d6d8664b4406c739ef3a6cc81",
            .hash = "thread_pool-0.2.8-11B1BrrSeQD3WHNJ-oyNkrfcHLp5AOW1Zgr4QTGu7pb4",
        },
        // OpenTelemetry instrumentation (gated behind -Dwith_otel; lazy = true
        // so the dependency is never fetched when the flag is off).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.19#d928525c34a4b50c9536b064e601ee45760cbabd",
            .hash = "otel-0.1.19-B0v3liP3NQDyqyLnDV_6rFYepKA7MNgekcHFstany4dq",
            .lazy = true,
        },
        // Published hash-pinned FIPS backend, resolved only under -Dfips=true.
        // The disabled backend uses the local canonical policy/stdlib shim.
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git#571f09ca5277dbdfab0d103450eb1b0353e0c810",
            .hash = "fips-0.1.2-1wf3naAACABLDDJ-ZoCElXmeDwwT-TU6zlj68xSWQ6Qi",
            .lazy = true,
        },
    },
}
